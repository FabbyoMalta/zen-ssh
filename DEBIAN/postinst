#!/bin/bash
# Script de pós-instalação do zen-connect

# Criação do diretório para grupos (se não existir)
if [ ! -d /etc/ssh/groups ]; then
    mkdir -p /etc/ssh/groups
    chmod 755 /etc/ssh/groups
fi

